{
  "name": "pendek",
  "version": "1.0.0",
  "private": true,
  "description": "Pendek is a modern URL shortener built with Next.js, Prisma, and PostgreSQL.",
  "engines": { "node": ">=20.9.0" },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.1.5",
    "next": "15.5.24",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hot-toast": "^2.5.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.24",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
