# Salin nilai ini ke Vercel Project Settings → Environment Variables.
# Jangan menyimpan kredensial nyata dalam repositori atau file ini.

# Prisma / Supabase — runtime server only, tandai sebagai Sensitive.
# Preview sebaiknya memakai database Supabase non-produksi agar link uji tidak bercampur dengan data publik.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Hanya diperlukan saat menjalankan migrasi Prisma dari CI/komputer developer, bukan untuk runtime Vercel.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Upstash Redis — runtime server only, tandai sebagai Sensitive.
UPSTASH_REDIS_REST_URL="https://[INSTANCE].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[UPSTASH_REDIS_REST_TOKEN]"

# Google reCAPTCHA — site key aman diekspos ke browser; secret hanya tersedia pada server.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="[GOOGLE_RECAPTCHA_SITE_KEY]"
RECAPTCHA_SECRET_KEY="[GOOGLE_RECAPTCHA_SECRET_KEY]"
